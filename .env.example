BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789

# Bothost: папка /app/data — единственное место, которое сохраняется
# между деплоями. Достаточно указать DATA_DIR, и база сама ляжет в
# /app/data/bot.db, даже если ниже остался относительный путь.
DATA_DIR=
DATABASE_URL=sqlite+aiosqlite:///bot.db

DAILY_TASK_TIME=18:00
TIMEZONE=Europe/Minsk
